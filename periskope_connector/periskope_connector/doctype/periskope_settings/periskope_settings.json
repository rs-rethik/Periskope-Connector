  },
  {
   "fieldname": "section_agent",
   "fieldtype": "Section Break",
   "label": "4. Auto Reply",
   "description": "The AI agent runs on its own once steps 1 to 3 are done: it reads every message, image and document, creates tasks, escalates, creates leads and keeps the CRM up to date. The only choice left is whether it answers customers itself."
  },
  {
   "fieldname": "enable_auto_reply",
   "fieldtype": "Check",
   "label": "Reply to Customers",
   "description": "When no rep has answered a customer within the time below, the AI answers from your data, or tells the customer a rep will reply and gives the rep a task.",
