  {
   "fieldname": "section_connect",
   "fieldtype": "Section Break",
   "label": "1. Connect Periskope"
  },
  {
   "default": "0",
   "description": "The master switch. When off, the webhook still answers Periskope (so it does not retry) but nothing is stored.",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enable Periskope Integration"
  },
  {
   "description": "Paste the API key from Periskope (console.periskope.app &gt; Settings &gt; Integrations &gt; API). It is shown only once, so keep a copy. Then click <b>Test Connection</b>.",
   "fieldname": "api_key",
   "fieldtype": "Password",
   "label": "Periskope API Key"
  },
  {
   "fieldname": "test_periskope",
   "fieldtype": "Button",
   "label": "Test Connection"
  },
  {
   "fieldname": "column_status",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "connection_status",
   "fieldtype": "Data",
   "label": "Connection Status",
   "read_only": 1
  },
  {
   "fieldname": "last_checked",
   "fieldtype": "Datetime",
   "label": "Last Tested On",
   "read_only": 1
  },
  {
   "fieldname": "section_webhook",
   "fieldtype": "Section Break",
   "label": "Receive Messages (Webhook)",
   "collapsible": 1
  },
  {
   "fieldname": "webhook_url",
   "fieldtype": "Data",
   "label": "Webhook URL to Add in Periskope",
   "read_only": 1
  },
  {
   "fieldname": "column_secret",
   "fieldtype": "Column Break"
  },
  {
   "description": "Paste the signing secret from Periskope (Settings &gt; Webhooks). The webhook itself is created for you by <b>Test Connection</b> or <b>Create Webhook in Periskope</b>; the secret is the one part Periskope does not return through its API.",
   "fieldname": "webhook_signing_secret",
   "fieldtype": "Password",
   "label": "Webhook Signing Secret"
  },
  {
   "fieldname": "section_ai",
   "fieldtype": "Section Break",
   "label": "2. AI"
  },
  {
   "description": "<b>Direct API</b> sends messages to Anthropic (or Z.ai) with your own key. <b>Jarvis</b> (shown only when the Jarvis app is installed) uses the model already set up there, so no key is needed here.",
   "fieldname": "ai_provider",
   "fieldtype": "Select",
   "label": "AI Provider",
   "options": "Direct API\nJarvis"
  },
  {
   "depends_on": "eval:doc.ai_provider!=\"Jarvis\"",
   "description": "Paste the API key of your AI provider: Anthropic (console.anthropic.com) for Claude models, or Z.ai for GLM models. Messages, images and PDFs are sent to that provider to be read. Then click <b>Test AI</b>. For GLM, also set <b>AI API Address</b> to <b>https://api.z.ai/api/anthropic</b>; only Claude models read images and PDFs.",
   "fieldname": "anthropic_api_key",
   "fieldtype": "Password",
   "label": "AI API Key"
  },
  {
   "default": "claude-haiku-4-5",
   "depends_on": "eval:doc.ai_provider!=\"Jarvis\"",
   "fieldname": "ai_model",
   "fieldtype": "Select",
   "label": "AI Model",
   "options": "claude-haiku-4-5\nclaude-sonnet-5-5\nclaude-opus-5-5\nglm-5.3\nglm-5.3-flash\nglm-4.7\nglm-4.5-air"
  },
  {
   "depends_on": "eval:doc.ai_provider!=\"Jarvis\"",
   "fieldname": "ai_base_url",
   "fieldtype": "Data",
   "label": "AI API Address"
  },
  {
